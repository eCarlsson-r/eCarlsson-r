# Base URL of the Carlsson Studio Spring Boot API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.carlssonstudio.com

# Meta Pixel ID (Events Manager → Data Sources → your pixel). Leave blank
# to keep the Pixel disabled — MetaPixel.tsx renders nothing without it.
NEXT_PUBLIC_META_PIXEL_ID=1069018588967069

# Studio's own WhatsApp Business number, for the "message us" button on
# the Start a Project results screen. Pre-normalized: digits only,
# international country code, no leading +, no leading 0
# (e.g. an Indonesian 0812... number becomes 62812...). Leave blank to
# hide the button — lib/whatsapp.ts renders nothing without it.
NEXT_PUBLIC_STUDIO_WHATSAPP_NUMBER=

# Google Tag Manager container ID (GTM-XXXXXXX). Leave blank to keep GTM
# disabled — GoogleTagManager.tsx renders nothing without it. GA4 and
# Google Ads conversion tags are configured inside the GTM dashboard
# itself, triggered on the "generate_lead" custom event (see lib/gtm.ts).
NEXT_PUBLIC_GTM_CONTAINER_ID=
